# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data directories (Track .gitkeep only, ignore data dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# Model weights and artifacts
models/*.pkl
models/*.joblib
models/*.onnx
artifacts/*
!artifacts/.gitkeep

# Logs and outputs
logs/*
!logs/.gitkeep
*.log

# Environment variables & secrets
.env
.env.local
.env.*.local

# IDE and OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Output figures in reports if too large, keep templates
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg
!reports/figures/.gitkeep

# Exclude private progression notes and local reports
reports/
Meet- Progression/
